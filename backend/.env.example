# ===========================================
# AI COUNSELLOR - PRODUCTION ENVIRONMENT
# ===========================================

# ----- DATABASE (Supabase PostgreSQL) -----
# Get this from: Supabase Dashboard → Settings → Database → Connection String
# Use the "Transaction" or "Session" pooler connection string
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ----- JWT AUTHENTICATION -----
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars

# ----- AI (Optional - works without it) -----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- EXTERNAL API -----
HIPOLABS_API_URL=http://universities.hipolabs.com/search
